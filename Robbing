<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>lolmath</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #0e0e0e;
    --surface: #161616;
    --border: #2a2a2a;
    --text: #e8e8e8;
    --muted: #666;
    --accent: #c8f135;
    --accent-dim: #8faa21;
    --font: 'Courier New', monospace;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    min-height: 100vh;
  }

  header {
    padding: 1.2rem 2rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 1.4rem;
    font-weight: bold;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .logo span { color: var(--muted); }

  .tagline {
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .search-bar {
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.4rem 0.8rem;
    gap: 0.5rem;
  }

  .search-bar input {
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font);
    font-size: 0.85rem;
    width: 180px;
  }

  .search-bar input::placeholder { color: var(--muted); }

  .search-bar svg { color: var(--muted); flex-shrink: 0; }

  main {
    padding: 2rem;
  }

  .section-label {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .game-card {
    background: var(--surface);
    padding: 1.4rem 1.2rem;
    cursor: pointer;
    transition: background 0.12s;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
    user-select: none;
  }

  .game-card:hover { background: #1e1e1e; }

  .game-card:hover .game-arrow { opacity: 1; }

  .game-icon {
    font-size: 1.6rem;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .game-name {
    font-size: 0.9rem;
    font-weight: bold;
    color: var(--text);
  }

  .game-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .game-arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.12s;
    font-size: 0.8rem;
  }

  .empty-card {
    background: var(--surface);
    padding: 1.4rem 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--border);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    min-height: 100px;
    border: 1px dashed var(--border);
  }

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 100;
    flex-direction: column;
  }

  .modal-overlay.open { display: flex; }

  .modal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1.2rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .modal-title {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: bold;
  }

  .modal-close {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font);
    font-size: 0.75rem;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    letter-spacing: 0.05em;
    transition: color 0.1s, border-color 0.1s;
  }

  .modal-close:hover { color: var(--text); border-color: var(--muted); }

  .modal-frame {
    flex: 1;
    width: 100%;
    border: none;
  }

  footer {
    padding: 1.5rem 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
  }

  .footer-left {
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    margin-right: 0.4rem;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .no-results {
    padding: 3rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: none;
  }
</style>
</head>
<body>

<header>
  <div>
    <div class="logo">lol<span>math</span></div>
    <div class="tagline">unblocked games</div>
  </div>
  <div class="search-bar">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input type="text" id="searchInput" placeholder="search games..." autocomplete="off">
  </div>
</header>

<main>
  <div class="section-label" id="toggleLabel" onclick="toggleGames()" style="cursor:pointer;user-select:none;">
    all games
    <span id="toggleArrow" style="margin-left:0.5rem;font-size:0.8rem;color:var(--accent);transition:transform 0.2s;display:inline-block;">▼</span>
  </div>

  <div id="gamesWrapper" style="overflow:hidden;transition:max-height 0.35s ease;">
    <div class="games-grid" id="gamesGrid"></div>
    <div class="no-results" id="noResults">no games found</div>
  </div>
</main>

<footer>
  <div class="footer-left"><span class="status-dot"></span>online — play anything</div>
  <div class="footer-left" id="gameCount"></div>
</footer>

<div class="modal-overlay" id="modal">
  <div class="modal-bar">
    <div class="modal-title" id="modalTitle"></div>
    <button class="modal-close" onclick="closeGame()">[ close ]</button>
  </div>
  <iframe class="modal-frame" id="gameFrame" allowfullscreen></iframe>
</div>

<script>
  const games = [
    {
      name: "FNaF 1",
      img: "data:image/png;base64,",
      tag: "horror",
      src: "fnaf1.html"
    },
    {
      name: "FNaF 2",
      img: "data:image/png;base64,",
      tag: "horror",
      src: "fnaf2.html"
    },
    {
      name: "FNaF 3",
      img: "data:image/png;base64,",
      tag: "horror",
      src: "fnaf3.html"
    },
    {
      name: "FNaF 4",
      img: "data:image/png;base64,",
      tag: "horror",
      src: "fnaf4.html"
    },
    {
      name: "Aqua.io",
      img: "data:image/png;base64,",
      tag: "online",
      src: "aquaio.html"
    },
    {
      name: "Basket Battle",
      img: "data:image/png;base64,",
      tag: "sports",
      src: "basketbattle.html"
    },
    {
      name: "Steal a Brainrot",
      img: "data:image/png;base64,",
      tag: "online",
      src: "stealabrainrot.html"
    },
    {
      name: "Bouncemasters",
      img: "data:image/png;base64,",
      tag: "arcade",
      src: "bouncemasters.html"
    },
    {
      name: "Football Bros",
      img: "data:image/png;base64,",
      tag: "sports",
      src: "footballbros.html"
    },
    {
      name: "BitLife",
      img: "data:image/png;base64,",
      tag: "simulation",
      src: "bitlife.html"
    },
    {
      name: "Baseball Bros",
      img: "data:image/png;base64,",
      tag: "sports",
      src: "baseballbros.html"
    },
    {
      name: "Soundboard",
      img: "data:image/png;base64,",
      tag: "fun",
      src: "soundboard.html"
    },
    {
      name: "Escape Road",
      img: "data:image/png;base64,",
      tag: "driving",
      src: "escaperoad.html"
    },
    {
      name: "1v1.lol",
      img: "data:image/png;base64,",
      tag: "shooter",
      src: "1v1lol.html"
    },
    {
      name: "Basket Bros",
      img: "data:image/png;base64,",
      tag: "sports",
      src: "basketbros.html"
    },
    {
      name: "Baldi's Basics",
      img: "data:image/png;base64,",
      tag: "horror",
      src: "baldisbasics.html"
    },
  ];

  const grid = document.getElementById('gamesGrid');
  const noResults = document.getElementById('noResults');
  const gameCount = document.getElementById('gameCount');

  function renderGames(list) {
    grid.innerHTML = '';
    if (list.length === 0) {
      noResults.style.display = 'block';
      grid.style.display = 'none';
      return;
    }
    noResults.style.display = 'none';
    grid.style.display = 'grid';
    list.forEach(g => {
      const card = document.createElement('div');
      card.className = 'game-card';
      const thumb = g.img
        ? `<img src="${g.img}" style="width:56px;height:56px;object-fit:cover;border-radius:8px;margin-bottom:0.3rem;" />`
        : `<div class="game-icon">${g.icon || '🎮'}</div>`;
      card.innerHTML = `
        <div class="game-arrow">▶</div>
        ${thumb}
        <div class="game-name">${g.name}</div>
        <div class="game-tag">${g.tag}</div>
      `;
      card.onclick = () => openGame(g);
      grid.appendChild(card);
    });

    if (list.length < 4) {
      const remaining = 4 - list.length;
      for (let i = 0; i < remaining; i++) {
        const empty = document.createElement('div');
        empty.className = 'empty-card';
        empty.textContent = 'coming soon';
        grid.appendChild(empty);
      }
    }
  }

  function openGame(g) {
    document.getElementById('modalTitle').textContent = '▶ ' + g.name;
    document.getElementById('gameFrame').src = g.src;
    document.getElementById('modal').classList.add('open');
  }

  function closeGame() {
    document.getElementById('modal').classList.remove('open');
    document.getElementById('gameFrame').src = '';
  }

  document.getElementById('searchInput').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    const filtered = games.filter(g =>
      g.name.toLowerCase().includes(q) || g.tag.toLowerCase().includes(q)
    );
    renderGames(filtered);
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeGame();
  });

  renderGames(games);
  gameCount.textContent = `${games.length} game${games.length !== 1 ? 's' : ''}`;

  const wrapper = document.getElementById('gamesWrapper');
  requestAnimationFrame(() => {
    wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
  });

  let open = true;
  function toggleGames() {
    const arrow = document.getElementById('toggleArrow');
    if (open) {
      wrapper.style.maxHeight = '0px';
      arrow.style.transform = 'rotate(-90deg)';
    } else {
      wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
      arrow.style.transform = 'rotate(0deg)';
    }
    open = !open;
  }
  window.toggleGames = toggleGames;
</script>
</body>
</html>
